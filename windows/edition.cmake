# Read APP_EDITION out of Flutter's generated config for direct flutter builds.
include("${CMAKE_CURRENT_LIST_DIR}/flutter/ephemeral/generated_config.cmake")
set(APP_PRODUCT "BaoCode" CACHE STRING "Native product edition (BaoCode or Abyss)")
foreach(TOOL_VARIABLE IN LISTS FLUTTER_TOOL_ENVIRONMENT)
  if(TOOL_VARIABLE MATCHES "^DART_DEFINES=(.*)$")
    string(REPLACE "," ";" DART_DEFINE_LIST "${CMAKE_MATCH_1}")
    foreach(DART_DEFINE_BASE64 IN LISTS DART_DEFINE_LIST)
      string(BASE64_DECODE "${DART_DEFINE_BASE64}" DART_DEFINE)
      if(DART_DEFINE MATCHES "^APP_EDITION=(BaoCode|Abyss)$")
        set(APP_PRODUCT "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endif()
endforeach()
if(APP_PRODUCT STREQUAL "Abyss")
  set(BINARY_NAME "Abyss")
  set(APP_DATA_FOLDER "abyss")
  set(APP_REGISTRY_ROOT "Software\\\\Abyss")
  set(APP_MUTEX "Local\\\\Abyss.SingleInstance")
  set(APP_OPEN_PROPERTY "Abyss.OpenRequests")
  set(APP_LOGIN_PROFILE "Abyss-Login")
  set(APP_WER_NAME "abyss_wer")
  set(APP_BUNDLE_BROWSER OFF)
elseif(APP_PRODUCT STREQUAL "BaoCode")
  set(BINARY_NAME "baocode")
  set(APP_DATA_FOLDER "baocode")
  set(APP_REGISTRY_ROOT "Software\\\\BaoCode")
  set(APP_MUTEX "Local\\\\BaoCode.SingleInstance")
  set(APP_OPEN_PROPERTY "BaoCode.OpenRequests")
  set(APP_LOGIN_PROFILE "BaoCode-Login")
  set(APP_WER_NAME "baocode_wer")
  set(APP_BUNDLE_BROWSER ON)
else()
  message(FATAL_ERROR "APP_PRODUCT / APP_EDITION must be BaoCode or Abyss, not ${APP_PRODUCT}")
endif()
